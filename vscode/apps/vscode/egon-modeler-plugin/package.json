{
  "name": "egon-modeler-plugin",
  "publishName": "egon-vscode-extension",
  "displayName": "Egon.io — The Domain Story Modeler",
  "description": "Write your (domain) story in a visual way with Egon.io.",
  "license": "SEE LICENSE IN LICENSE",
  "version": "0.3.0",
  "publisher": "miragon-gmbh",
  "homepage": "https://www.miragon.io/",
  "badges": [
    {
      "url": "https://img.shields.io/badge/Follow-@miragon__io-1DA1F2?style=social&logo=twitter&logoColor=1DA1F2",
      "href": "https://twitter.com/miragon_io",
      "description": "Our Twitter profile."
    },
    {
      "url": "https://img.shields.io/badge/Follow-miragon-blue?style=social&logo=linkedin&logoColor=blue&url=https://www.linkedin.com/company/miragon-io",
      "href": "https://www.linkedin.com/company/miragon-io",
      "description": "Our LinkedIn profile."
    }
  ],
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Miragon/egon.io.git"
  },
  "bugs": {
    "url": "https://github.com/Miragon/egon.io/issues"
  },
  "engines": {
    "vscode": "^1.76.0"
  },
  "icon": "assets/egon-io-logo.png",
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "DDD",
    "Domain Driven Design",
    "Domain Storytelling",
    "diagram-js"
  ],
  "main": "main.js",
  "activationEvents": [
    "onCustomEditor:egon.io"
  ],
  "private": true,
  "scripts": {
    "dev": "webpack --mode development --watch",
    "build": "webpack --mode production"
  },
  "contributes": {
    "customEditors": [
      {
        "id": "egon.io",
        "viewType": "egon.io",
        "displayName": "Egon.io: Domain Story Modeler",
        "selector": [
          {
            "filenamePattern": "*.egn"
          }
        ],
        "priority": "default"
      }
    ],
    "menus": {},
    "configuration": {},
    "walkthroughs": [
      {
        "id": "getStarted",
        "title": "Get Started with Egon.io",
        "description": "Model Domain Stories visually in VS Code — actors, work objects, and a numbered sequence of activities, all saved as a plain-text .egn file.",
        "steps": [
          {
            "id": "create",
            "title": "Create your first domain story",
            "description": "Create a file and save it as `.egn` to open it in the Egon.io modeler.\n[New file](command:workbench.action.files.newUntitledFile)",
            "media": {
              "markdown": "media/walkthrough/create.md"
            },
            "completionEvents": [
              "onStepSelected"
            ]
          },
          {
            "id": "learn",
            "title": "Learn the basics",
            "description": "Drag actors and work objects from the palette, connect them into a numbered story, and let the text file stay in sync as your source of truth.",
            "media": {
              "markdown": "media/walkthrough/learn.md"
            },
            "completionEvents": [
              "onStepSelected"
            ]
          }
        ]
      }
    ]
  }
}
